<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>1.0.7</Version>
    <InformationalVersion>1.07</InformationalVersion>
    <ApplicationIcon>assets\XMLator.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AllowedReferenceRelatedFileExtensions>.pdb</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="vendor\**\*.cs;tests\**\*.cs;robocze\**\*.cs;niepotrzebne\**\*.cs" />
    <EmbeddedResource Include="assets\XMLator.ico" LogicalName="XMLator.ApplicationIcon.ico" />
    <EmbeddedResource Include="assets\UsbMedia.ps1" LogicalName="XMLator.UsbMedia.ps1" />
    <EmbeddedResource Include="assets\KeepSingleMbrPartition.ps1" LogicalName="XMLator.KeepSingleMbrPartition.ps1" />
    <EmbeddedResource Include="assets\ApplyUpdate.ps1" LogicalName="XMLator.ApplyUpdate.ps1" />
    <EmbeddedResource Include="assets\UsbDiagnosticKeys.txt" LogicalName="XMLator.UsbDiagnosticKeys.txt" />
    <EmbeddedResource Include="assets\Translations\*.json" LogicalName="XMLator.Translations.%(Filename)%(Extension)" />
    <EmbeddedResource Include="assets\Manual\*.html" LogicalName="XMLator.Manual.%(Filename)%(Extension)" />
    <EmbeddedResource Include="THIRD-PARTY-NOTICES.txt" LogicalName="XMLator.ThirdPartyNotices.txt" />
    <PackageReference Include="DiscUtils.Udf" Version="0.16.13" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" ExcludeAssets="build;buildTransitive" GeneratePathProperty="true" />
    <Reference Include="Microsoft.Web.WebView2.Core" HintPath="$(PkgMicrosoft_Web_WebView2)\lib_manual\netcoreapp3.0\Microsoft.Web.WebView2.Core.dll" />
    <ProjectReference Include="vendor\Schneegans\Schneegans.Unattend.csproj" />
    <InternalsVisibleTo Include="XMLator.Checks" />
  </ItemGroup>
</Project>
